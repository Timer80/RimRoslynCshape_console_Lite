<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SlashHarness —— Slash 指令扩充的专用测试/编译面工程(S11-1 由 _slash-staging/SlashCheck.csproj 搬来)。

    形态(照集成计划 S11-1b 的选项 A):编 ..\..\Source\**\*.cs(主工程全集) + 本目录 **\*.cs(测试类 + SlashTestHarness;
    跑手入口 RunnerMain.cs 被 Exclude —— 见下面 Compile 项的注释,S11-5b)。
    好处:①14 个测试类不用改写成 xunit(3800+ 断言) ②在同一编译面验证 14 条指令与 Source/Game 其余文件共存
    ③测试与源文件同程序集 ⇒ internal 测试缝可用。

    铁律:
      * 输出只落仓库外($(TEMP)),绝不写 1.7\Assemblies\RoslynProbe.dll;
      * 不 ProjectReference / 不构建 Source\RoslynProbe.csproj(只编源文件);
      * 临时路径一律用已展开的 $env:TEMP(不要写 %TEMP%),见 docs/slash-fleet-rules.md 第 7 节。

    用法:
      dotnet msbuild -restore:false tests\SlashHarness\SlashHarness.csproj -t:Rebuild `
        -p:OutputPath=$env:TEMP\slashharness\ -p:BaseIntermediateOutputPath=$env:TEMP\slashobj\<name>\
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SlashHarness</AssemblyName>
    <RootNamespace>RoslynProbe</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(OutputPath)' == ''">$(TEMP)\slashharness\</OutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">$(TEMP)\slashobj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!--
    -restore:false 的资产文件兜底(与 SlashCheck 同款):本工程与主工程同 TFM(net10.0)、同为零 PackageReference、
    同为零 ProjectReference,故当自己的中间目录里没有 project.assets.json 时直接复用主工程已还原的那份。
    (ProjectAssetsFile 的 SDK 默认值在 .targets 阶段才赋,工程体里 '$(ProjectAssetsFile)' 必为空。)
  -->
  <PropertyGroup>
    <_SlashHarnessFallbackAssets>$(MSBuildThisFileDirectory)..\..\Source\obj\project.assets.json</_SlashHarnessFallbackAssets>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ProjectAssetsFile)' == '' And !Exists('$(BaseIntermediateOutputPath)project.assets.json') And Exists('$(_SlashHarnessFallbackAssets)')">
    <ProjectAssetsFile>$(_SlashHarnessFallbackAssets)</ProjectAssetsFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主工程全集:只读编入(Exclude 生成物,否则与 AssemblyAttributes/AssemblyInfo 重复) -->
    <Compile Include="..\..\Source\**\*.cs" Exclude="..\..\Source\obj\**\*.cs;..\..\Source\bin\**\*.cs" />
    <!--
      本目录:测试类 + SlashTestHarness。
      Exclude 里的 RunnerMain.cs 是 S11-5b 跑手(SlashHarnessRunner.csproj)的入口 —— 它**故意**不在本工程的编译面里:
      否则「加一个跑手」会改变 SlashHarness.dll 的字节内容(多一个无害的 Main),把绑在纯净检出上的 harness 哈希作废。
    -->
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs;RunnerMain.cs;$(MSBuildProjectName).csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用块与 Source\RoslynProbe.csproj 逐条一致(HintPath 照抄;Private=false 不外带) -->
    <Reference Include="UnityStubs"><HintPath>C:\SteamLibrary\steamapps\common\RimWorld\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>C:\SteamLibrary\steamapps\common\RimWorld\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>C:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>C:\SteamLibrary\steamapps\common\RimWorld\Mods\Roslyn\Roslyn\Microsoft.CodeAnalysis.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>C:\SteamLibrary\steamapps\common\RimWorld\Mods\Roslyn\Roslyn\Microsoft.CodeAnalysis.CSharp.dll</HintPath><Private>false</Private></Reference>
